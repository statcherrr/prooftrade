# Server-side environment for the ProofTrade frontend.
# Copy to .env.local for local development; never commit real values.

# Origin of the FastAPI audit backend. Read at request time by the
# /api/audit route handler; it is never shipped to the browser.
PROOFTRADE_API_ORIGIN=http://127.0.0.1:8000

# Port used by `next start` (defaults to 3000 when unset).
PORT=3000
